# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Database ====================
# Choose ONE backend:
#
# 1) PostgreSQL (recommended for shared/production deployments)
#    Set DATABASE_URL and leave DB_PATH unused.
#    Example:
#    DATABASE_URL=postgresql://ai_trader:change-me@127.0.0.1:5432/ai_trader
#
# 2) SQLite (local-only quick start)
#    Leave DATABASE_URL empty. The API uses DB_PATH below.
#
# Precedence: if DATABASE_URL is non-empty, PostgreSQL is used and DB_PATH is ignored.
DATABASE_URL=

# SQLite file path — only used when DATABASE_URL is empty.
# A relative path is resolved against the repository root.
DB_PATH=service/server/data/clawtrader.db

# ==================== API Keys ====================
ALPHA_VANTAGE_API_KEY=demo
# Optional: enrich US stock market-intel snapshots with Adanos social/news/prediction-market sentiment.
ADANOS_API_KEY=

# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000

# ==================== Network / CORS ====================
CLAWTRADER_CORS_ORIGINS=http://localhost:3000,https://ai4trade.ai

# ==================== Market Data Endpoints ====================
ADANOS_API_BASE_URL=https://api.adanos.org
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Background Tasks ====================
POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800
ADANOS_SENTIMENT_CACHE_TTL_SECONDS=300
ADANOS_SENTIMENT_TIMEOUT_SECONDS=4

# ==================== Profit History Retention ====================
# Keep recent history at full resolution.
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24

# Keep compacted history inside this rolling window.
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7

# Bucket size used when compacting older profit history.
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15

# Minimum interval between prune/compact passes.
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60

# ==================== Auto-trader ====================
# Read this section as a ladder. Every rung is a deliberate step towards real
# money, and leaving a rung unset always lands on the safer side.
#
# Rung 0 (the default, nothing set): paper broker, Binance testnet for data,
#        auto-trading off. The analysis endpoints work; no order is ever sent.

# Where candles come from: binance | synthetic | replay
# "synthetic" is a generated feed for demonstrations — it is labelled as such
# in every response and on screen, and it is not a market.
MARKET_DATA_PROVIDER=binance

# Rung 1: leave the paper broker. Orders now go to Binance *testnet*.
PAPER_TRADING=true

# Rung 2: leave the testnet. Refused on its own — rung 3 is also required.
BINANCE_TESTNET=true

# Rung 3: arm live trading. With BINANCE_TESTNET=false this is the real book.
# Before the first live order the broker asks Binance what the key may do and
# refuses if withdrawals are enabled. Create a trade-only key.
LIVE_TRADING_ARMED=false

# Binance credentials. Trade permission only — never withdrawal.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Whether the engine may place orders at all. Off means the whole pipeline
# still runs and reports, which is the useful part while a configuration is
# being judged, but nothing is sent anywhere.
AUTO_TRADE_ENABLED=false

# What the background loop watches, and how often it sweeps (seconds, floor 15).
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
AUTO_TRADE_INTERVAL=5m
AUTO_TRADE_PERIOD_SECONDS=60

# Confluence a setup must clear while a bucket is still learning. Raise it for
# fewer and stronger entries; lower it to gather a sample faster. Measured
# range: a textbook trend scores about 69, and nothing has reached 90.
CONFLUENCE_GATE=65

# Starting equity for the paper broker.
PAPER_EQUITY=10000

# Optional: the AI council. With no key the four agents run on their
# deterministic fallbacks and reach the same verdict — that is a supported
# configuration, not a degraded one.
OPENROUTER_API_KEY=
# Free models get retired and renamed; override the list without patching code.
OPENROUTER_MODELS=

# Optional: market breadth for the macro agent.
CMC_API_KEY=
